{
  "name": "bwt-byte-backend",
  "version": "1.0.0",
  "description": "本地字节块 Burrows-Wheeler 可逆变换后端（API + CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "bwt": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings dist/cli.js serve",
    "test": "node --no-warnings --test --import tsx \"test/**/*.test.ts\"",
    "demo": "node --no-warnings --import tsx src/cli.ts demo"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
